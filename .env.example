# deepinfra (default, no install needed)
DEEPINFRA_API_KEY=

# local model via ollama (must support tool calling — gemma3:4b does NOT):
# 1) ollama pull qwen3:4b
# 2) set SICOSIG_BASE_URL=http://localhost:11434/v1
# 3) set SICOSIG_MODEL=qwen3:4b
# SICOSIG_BASE_URL=
# SICOSIG_MODEL=

# only needed for EMT bus arrivals, metro and cercanias work without them
# EMT_CLIENT_ID=
# EMT_PASS_KEY=
